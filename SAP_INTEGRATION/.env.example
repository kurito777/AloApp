# ═══════════════════════════════════════════════════════════════════════════
# .env.example — Template de variables de entorno para SAP B1
# ALO Group Field App
#
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env.dev
#   2. Reemplazar los valores placeholder con los reales
#   3. NUNCA commitear .env.dev o .env.prod con valores reales
#
# SEGURIDAD:
#   - Asegúrate de que .gitignore tenga: .env.dev y .env.prod
#   - Solo .env.example (sin contraseñas) puede estar en el repositorio
# ═══════════════════════════════════════════════════════════════════════════

# ── SAP B1 Service Layer ───────────────────────────────────────────────────
# URL base del SAP B1 Service Layer (incluye /b1s/v1)
SAP_BASE_URL=https://sap.alo-group.com:50000/b1s/v1

# Nombre de la empresa (CompanyDB) en SAP B1
# Preguntar al administrador SAP cuál es el correcto
SAP_COMPANY=ZTEST_AR_TRIBUTARIO

# Usuario de servicio para la app móvil
# Este usuario debe tener permisos de lectura/escritura en VID_RTOV
SAP_SERVICE_USER=INDACC02

# Contraseña del usuario de servicio
# ⚠️  NUNCA commitear este archivo con la contraseña real
SAP_SERVICE_PASSWORD=TestIC2024

# ── General (opcional) ─────────────────────────────────────────────────────
# Entorno actual: development | staging | production
ENVIRONMENT=development

# ── Notas para el equipo ───────────────────────────────────────────────────
# Para obtener las credenciales reales, contactar a:
#   - Administrador SAP: [nombre del admin]
#   - DevOps/IT: [nombre del equipo]
#
# Para verificar acceso antes de usar la app:
#   curl -k -X POST https://sap.alo-group.com:50000/b1s/v1/Login \
#     -H "Content-Type: application/json" \
#     -d '{"CompanyDB":"SAP_COMPANY","UserName":"SVCMOBILE","Password":"PASSWORD"}'
#
# Respuesta esperada (éxito):
#   {"SessionId":"XXXXXXXXXX","SessionTimeout":30,"Version":"..."}
