# AloApp - variables de entorno (plantilla)
# Copiar este archivo como .env.dev y .env.prod y completar con valores reales.
# NO subir .env.dev ni .env.prod al repositorio (están en .gitignore).

ENVIRONMENT=development

# API / backend
API_BASE_URL=http://localhost:8080

# SAP Business One (Service Layer)
SAP_BASE_URL=https://localhost:50000/b1s/v1
SAP_COMPANY=TEST_DB
SAP_SERVICE_USER=usuario_servicio
SAP_SERVICE_PASSWORD=cambiar
SAP_VERIFY_TLS=false
# Mantener en false mientras se prueba (bloquea escrituras hacia SAP)
SAP_WRITE_ENABLED=false

# Google Maps (ubicación de obra)
GOOGLE_MAPS_API_KEY=tu_api_key

# Dashboard
DASHBOARD_RECENT_DAYS=30
